# Logs
logs/
*.log

# Benchmark results: ignore ad-hoc runs, but commit frozen baselines explicitly.
# Frozen baselines are named `<step>-baseline-*.json` and tied to a specific
# commit in CLEANUP_PLAN.md; they must live in the tree so comparisons with a
# later run are reproducible.
benchmark-results/*.txt
benchmark-results/*.txt.summary
benchmark-results/*.json
!benchmark-results/.gitkeep
!benchmark-results/*-baseline-*.json
!benchmark-results/*-baseline-*.json.summary

# Autobahn test reports (generated)
autobahn/reports/

# JVM crash artifacts
hs_err_pid*
core.*

# Runtime logs
replay_*.log

# Local-only working docs (design notes, audit reports)
docs/internal/

# scala-cli caches
.scala-build/
**/.scala-build/
